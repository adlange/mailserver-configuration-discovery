<?xml version="1.0" encoding="UTF-8"?>

<!-- Unknown authentication methods and socket types must be ignored without failing the whole document. -->
<clientConfig version="1.1">
    <emailProvider id="example.com">
        <domain>example.com</domain>

        <incomingServer type="imap">
            <hostname>imap.example.com</hostname>
            <port>993</port>
            <socketType>quantum</socketType>
            <authentication>password-cleartext</authentication>
            <authentication>magic-token</authentication>
            <username>%EMAILADDRESS%</username>
        </incomingServer>

        <outgoingServer type="smtp">
            <hostname>smtp.example.com</hostname>
            <port>587</port>
            <socketType>STARTTLS</socketType>
            <authentication>SMTP-after-POP</authentication>
            <username>%EMAILADDRESS%</username>
        </outgoingServer>
    </emailProvider>
</clientConfig>
